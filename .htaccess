# Reality Social · realityapp.org/social
RewriteEngine On
RewriteBase /social/

# Protege configuración, plantillas y scripts SQL
RedirectMatch 404 ^/social/config(/|$)
RedirectMatch 404 ^/social/config-example(/|$)
RedirectMatch 404 ^/social/includes(/|$)
RedirectMatch 404 ^/social/\.git
RedirectMatch 404 ^/social/.*\.sql$

DirectoryIndex index.php index.html
